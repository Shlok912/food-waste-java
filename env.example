# Optional: create a Gemini API key in your own Google AI Studio account.
# Do not commit a real API key. The Spring Boot app reads GEMINI_API_KEY
# from the server process environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Keep the local default for development. Set this to the exact website origin
# only when the browser frontend is hosted separately.
APP_CORS_ALLOWED_ORIGIN=http://localhost:8080
